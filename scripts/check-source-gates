#!/bin/bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

failure_count=0

require_marker() {
  local file=$1
  local marker=$2
  local code=$3
  if ! grep -F -- "$marker" "$file" >/dev/null; then
    printf '%s file=%s marker=%s\n' "$code" "$file" "$marker" >&2
    failure_count=$((failure_count + 1))
  fi
}

reject_marker() {
  local file=$1
  local marker=$2
  local code=$3
  if grep -F -- "$marker" "$file" >/dev/null; then
    printf '%s file=%s marker=%s\n' "$code" "$file" "$marker" >&2
    failure_count=$((failure_count + 1))
  fi
}

require_marker Dockerfile.dapper 'ARG GO_VERSION=1.26.5' EXTERNAL_DNS_GO_VERSION_NOT_CURRENT
require_marker Dockerfile.dapper 'ARG GO_LINUX_AMD64_SHA256=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053' EXTERNAL_DNS_GO_AMD64_SHA_MISSING
require_marker Dockerfile.dapper 'ARG GO_LINUX_ARM64_SHA256=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49' EXTERNAL_DNS_GO_ARM64_SHA_MISSING
require_marker Dockerfile.dapper 'ARG DOCKER_LINUX_AMD64_SHA256=e985c6dc5008b8d62d6bdf9b5894427d075b335a1391cacf24ee01a7a29a3728' EXTERNAL_DNS_DOCKER_AMD64_SHA_MISSING
require_marker Dockerfile.dapper 'ARG DOCKER_LINUX_ARM64_SHA256=ce2cea8c740707d736ab356239f858d2272470d0734b5d14f20b950d1d6b952e' EXTERNAL_DNS_DOCKER_ARM64_SHA_MISSING
require_marker Dockerfile.dapper 'echo "${docker_sha}  /tmp/docker.tgz" | sha256sum -c -' EXTERNAL_DNS_DOCKER_SHA_NOT_CHECKED
reject_marker Dockerfile.dapper 'curl -fsSL "https://download.docker.com' EXTERNAL_DNS_DOCKER_DOWNLOAD_UNBOUNDED
require_marker package/Dockerfile 'USER 10001:10001' EXTERNAL_DNS_RUNTIME_NOT_NON_ROOT
require_marker package/Dockerfile 'org.opencontainers.image.version="${VERSION}"' EXTERNAL_DNS_OCI_VERSION_MISSING
require_marker package/Dockerfile 'org.opencontainers.image.revision="${REVISION}"' EXTERNAL_DNS_OCI_REVISION_MISSING
require_marker scripts/package 'test "${legal_count}" -eq 28' EXTERNAL_DNS_LEGAL_COUNT_GATE_MISSING
require_marker providers/route53/route53.go 'ROUTE53_ENDPOINT_URL' EXTERNAL_DNS_ROUTE53_ENDPOINT_OVERRIDE_MISSING
require_marker main.go '_ "github.com/PastureStack/external-dns-sync/providers/route53"' EXTERNAL_DNS_ROUTE53_RUNTIME_REGISTRATION_MISSING
require_marker internal/platformapi/client.go 'return http.ErrUseLastResponse' EXTERNAL_DNS_PLATFORM_REDIRECT_GATE_MISSING
require_marker package/update-platform-ca 'CA_BUNDLE_PATH="${PLATFORM_CA_BUNDLE_PATH:-/tmp/pasturestack-ca-bundle.crt}"' EXTERNAL_DNS_NON_ROOT_CA_BUNDLE_MISSING
require_marker package/entrypoint.sh 'export PLATFORM_URL="${PLATFORM_URL:-${CATTLE_URL:-}}"' EXTERNAL_DNS_AGENT_URL_MAPPING_MISSING
require_marker README.md 'ghcr.io/pasturestack/external-dns-sync:v0.8.0' EXTERNAL_DNS_README_VERSION_TAG_MISSING
require_marker metadata/metadata.go '"io.rancher.service.external_dns"' EXTERNAL_DNS_LEGACY_SERVICE_POLICY_LABEL_MISSING
require_marker metadata/metadata.go '"io.rancher.host.external_dns"' EXTERNAL_DNS_LEGACY_HOST_POLICY_LABEL_MISSING
require_marker metadata/metadata.go '"io.rancher.host.external_dns_ip"' EXTERNAL_DNS_LEGACY_HOST_ADDRESS_LABEL_MISSING
require_marker metadata/metadata.go '"io.rancher.service.external_dns_name_template"' EXTERNAL_DNS_LEGACY_SERVICE_TEMPLATE_LABEL_MISSING

legal_count=$(
  git ls-files 'vendor/**' |
    grep -E '(^|/)(LICENSE[^/]*|NOTICE[^/]*|COPYING[^/]*|COPYRIGHT[^/]*|AUTHORS[^/]*)$' |
    wc -l
)
if [ "$legal_count" -ne 28 ]; then
  printf 'EXTERNAL_DNS_LEGAL_FILE_COUNT_MISMATCH count=%s expected=28\n' "$legal_count" >&2
  failure_count=$((failure_count + 1))
fi

registered_provider_count=$(
  grep -Ec '^[[:space:]]*_ "github.com/PastureStack/external-dns-sync/providers/' main.go
)
if [ "$registered_provider_count" -ne 1 ]; then
  printf 'EXTERNAL_DNS_PUBLISHED_PROVIDER_COUNT_MISMATCH count=%s expected=1\n' \
    "$registered_provider_count" >&2
  failure_count=$((failure_count + 1))
fi

if grep -RInE --exclude-dir=.git --exclude-dir=vendor \
  --exclude=check-source-gates \
  --exclude=README.md --exclude=ORIGIN.md --exclude=THIRD_PARTY_NOTICES.md \
  'chen21019|10\.0\.0\.125' . >/dev/null; then
  printf 'EXTERNAL_DNS_PUBLIC_IDENTITY_OR_PRIVATE_HOST_FOUND\n' >&2
  failure_count=$((failure_count + 1))
fi

brand_hits=$(
  grep -RInE --exclude-dir=.git --exclude-dir=vendor \
  --exclude=check-source-gates \
  --exclude=README.md --exclude=ORIGIN.md --exclude=COMPATIBILITY.md \
  --exclude=THIRD_PARTY_NOTICES.md --exclude=UNOFFICIAL_MAINTENANCE_FORK.md \
  'rancher' . || true
)
unexpected_brand_hits=$(
  printf '%s\n' "$brand_hits" |
    grep -vE '^\./metadata/(metadata\.go|contracts_test\.go):[0-9]+:.*io\.rancher\.(service\.external_dns(_name_template)?|host\.external_dns(_ip)?)' ||
    true
)
if [ -n "$unexpected_brand_hits" ]; then
  printf 'EXTERNAL_DNS_BRAND_REFERENCE_OUTSIDE_ATTRIBUTION_FOUND\n' >&2
  failure_count=$((failure_count + 1))
fi

legacy_source_label_count=$(
  grep -Eo 'io\.rancher\.(service\.external_dns(_name_template)?|host\.external_dns(_ip)?)' \
    metadata/metadata.go metadata/contracts_test.go |
    wc -l
)
if [ "$legacy_source_label_count" -ne 8 ]; then
  printf 'EXTERNAL_DNS_LEGACY_LABEL_SCOPE_MISMATCH count=%s expected=8\n' \
    "$legacy_source_label_count" >&2
  failure_count=$((failure_count + 1))
fi

if grep -RInE --exclude-dir=.git --exclude-dir=vendor \
  'ghcr\.io/pasturestack/external-dns-sync:((latest|main|master)([^[:alnum:]._-]|$)|[^[:space:]]*@sha256:)' \
  README.md COMPATIBILITY.md package scripts main.go internal providers >/dev/null; then
  printf 'EXTERNAL_DNS_MUTABLE_OR_DIGEST_OPERATIONAL_REFERENCE_FOUND\n' >&2
  failure_count=$((failure_count + 1))
fi

printf 'failure_count=%s\n' "$failure_count"
if [ "$failure_count" -ne 0 ]; then
  exit 1
fi

printf 'EXTERNAL_DNS_SOURCE_GATES_OK go=1.26.5 ubuntu=26.04 non_root=1 legal_files=%s endpoint_override=bounded\n' \
  "$legal_count"
